{
  "name": "figtree-cli",
  "version": "1.0.2",
  "description": "CLI tool to extract design tokens from Figma and convert them to various code formats using AI",
  "main": "bin/figtree.js",
  "bin": {
    "figtree": "bin/figtree.js"
  },
  "scripts": {
    "start": "node bin/figtree.js",
    "dev": "node bin/figtree.js",
    "test": "node --test",
    "lint": "eslint src/ bin/",
    "lint:fix": "eslint src/ bin/ --fix",
    "prepare": "node scripts/prepare.js"
  },
  "keywords": [
    "figma",
    "design-tokens",
    "design-system",
    "cli",
    "codegen",
    "ai",
    "css",
    "tailwind",
    "swift",
    "android",
    "design-to-code"
  ],
  "files": [
    "bin/",
    "src/",
    "env.example",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortastudios/figtree-cli.git"
  },
  "homepage": "https://github.com/tortastudios/figtree-cli#readme",
  "bugs": {
    "url": "https://github.com/tortastudios/figtree-cli/issues"
  },
  "author": "Torta Studios LLC",
  "license": "FSL-1.1-MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.140",
    "@ai-sdk/deepseek": "^2.0.80",
    "@ai-sdk/google": "^3.0.143",
    "@ai-sdk/openai": "^3.0.139",
    "ai": "^6.0.326",
    "chalk": "^5.4.1",
    "dotenv": "^16.6.1",
    "inquirer": "^9.3.7",
    "ora": "^7.0.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1"
  },
  "funding": {
    "type": "contact",
    "url": "mailto:tech@tortastudios.com"
  },
  "type": "module",
  "preferGlobal": true
}
